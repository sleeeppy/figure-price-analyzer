# Gemini API key for rerank + web lookup
# Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Rerank + lookup fallback (high RPD on free tier)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_LOOKUP_MODEL=gemini-3.1-flash-lite

# Web lookup + Google Search (free tier: 2.5-flash Search Grounding ~1.5K RPD; 3.1 = ~500 Web only)
GEMINI_LOOKUP_SEARCH_MODEL=gemini-2.5-flash
# GEMINI_LOOKUP_USE_SEARCH=true

# Optional: override DB / data paths
# DATA_DIR=./data
